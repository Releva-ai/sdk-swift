<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Every declaration below is traceable to a call site in this repository;
	     see PrivacyManifestTests, which pins the entries this file must and must
	     not contain. When you add a tracking call or a new field to the push
	     payload, update this file in the same commit. -->
	<!-- false, signed off by Releva (2026-08-11) and not a placeholder. The
	     collected data is used for first-party personalisation and measurement
	     within the integrating app; server-side conversion forwarding to ad
	     platforms is treated as the integrator's own measurement rather than
	     Apple-defined tracking (linking with third-party data for targeted
	     advertising, or sharing with a data broker). Revisit if the SDK itself
	     ever starts sending to an ad network, or if data is shared onward in a
	     way that meets that definition — and note that flipping this to true
	     also means flipping the per-datatype Tracking flags below. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<!-- Deliberately empty, and it must stay empty unless someone accepts the
	     consequence: the OS blocks network requests to every domain listed here
	     when the user has not granted App Tracking Transparency permission.
	     Listing releva.ai or a <realm>.releva.ai host would therefore silently
	     break tracking, push-token registration and personalisation for every
	     user who declines the ATT prompt — the SDK's only endpoints are those
	     hosts (see NetworkService.getBaseURL()). -->
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- Purposes: ProductPersonalization + AppFunctionality + Analytics.
	     Analytics was signed off by Releva (2026-08-11) and is not provisional:
	     the platform's Customer Insights features — RFM scoring, cohort
	     analysis, funnels and audience performance — are built on exactly the
	     identifiers and events declared below, which is Apple's Analytics
	     purpose ("evaluating user behavior ... to measure audience size or
	     characteristics"). buildContext() (RelevaClient.swift) also sends
	     session count, view count and first-seen date on every request.

	     One deliberate exception: the NPS free-text comment at the bottom of
	     this list stays AppFunctionality-only. It is read individually by a
	     marketer rather than aggregated into an audience measure, so Analytics
	     is not justifiable for it on the same reasoning. Revisit if that
	     changes. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- The `profileId` the integrator sets via RelevaClient.setProfileId(_:),
		     sent as context.profile.id on every request. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeProductPersonalization</string>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<!-- The `deviceId` the integrator sets via RelevaClient.setDeviceId(_:),
		     the FCM push token uploaded by registerPushToken(_:deviceType:), and
		     the session ID: a UUID generated per session and persisted across
		     launches as rlv_session_id (StorageService.swift), sent as
		     context.sessionId on every request. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeProductPersonalization</string>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<!-- Screen and product views, cart and wishlist contents, custom events,
		     and banner / story / NPS impressions and clicks. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeProductPersonalization</string>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<!-- The verbatim query string passed to
		     RelevaClient.trackSearchView(query:...). -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeSearchHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeProductPersonalization</string>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<!-- Order ID, ordered products, quantities, prices and total from
		     RelevaClient.trackCheckoutSuccess(orderedCart:screenToken:). -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePurchaseHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeProductPersonalization</string>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<!-- The optional free-text `comment` on
		     RelevaClient.submitNpsResponse(token:score:comment:) — user-authored
		     prose, so it is user content rather than product interaction. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- StorageService is the SDK's only required-reason API use: it reads and
		     writes its own `rlv_`-prefixed keys in UserDefaults.standard (no
		     suiteName, so no App Group), which is what CA92.1 covers. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
