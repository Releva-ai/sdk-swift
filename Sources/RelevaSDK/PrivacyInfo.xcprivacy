<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Every declaration below is traceable to a call site in this repository;
	     see PrivacyManifestTests, which pins the entries this file must and must
	     not contain. When you add a tracking call or a new field to the push
	     payload, update this file in the same commit. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<!-- Deliberately empty, and it must stay empty unless someone accepts the
	     consequence: the OS blocks network requests to every domain listed here
	     when the user has not granted App Tracking Transparency permission.
	     Listing releva.ai or a <realm>.releva.ai host would therefore silently
	     break tracking, push-token registration and personalisation for every
	     user who declines the ATT prompt — the SDK's only endpoints are those
	     hosts (see NetworkService.getBaseURL()). -->
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- Purposes below are ProductPersonalization + AppFunctionality only.
	     Flagged for the same human/product sign-off as NSPrivacyTracking above:
	     buildContext() (RelevaClient.swift) labels its own device block "with
	     analytics" and sends session count, view count and first-seen date on
	     every request, alongside the identifiers and events below. Whether that
	     is Apple's Analytics purpose ("evaluating user behavior ... to plan new
	     features, or measure audience size or characteristics") depends on how
	     Releva's backend uses it, which is not visible from this repository —
	     do not add NSPrivacyCollectedDataTypePurposeAnalytics without that
	     answer, and do not assume its absence is settled either. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- The `profileId` the integrator sets via RelevaClient.setProfileId(_:),
		     sent as context.profile.id on every request. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeProductPersonalization</string>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- The `deviceId` the integrator sets via RelevaClient.setDeviceId(_:),
		     the FCM push token uploaded by registerPushToken(_:deviceType:), and
		     the session ID: a UUID generated per session and persisted across
		     launches as rlv_session_id (StorageService.swift), sent as
		     context.sessionId on every request. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeProductPersonalization</string>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Screen and product views, cart and wishlist contents, custom events,
		     and banner / story / NPS impressions and clicks. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeProductPersonalization</string>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- The verbatim query string passed to
		     RelevaClient.trackSearchView(query:...). -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeSearchHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeProductPersonalization</string>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Order ID, ordered products, quantities, prices and total from
		     RelevaClient.trackCheckoutSuccess(orderedCart:screenToken:). -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePurchaseHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeProductPersonalization</string>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- The optional free-text `comment` on
		     RelevaClient.submitNpsResponse(token:score:comment:) — user-authored
		     prose, so it is user content rather than product interaction. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- StorageService is the SDK's only required-reason API use: it reads and
		     writes its own `rlv_`-prefixed keys in UserDefaults.standard (no
		     suiteName, so no App Group), which is what CA92.1 covers. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
